# 秘密情報（OpenAI APIキー）。階層を問わず除外する（Code/.env も対象）
.env
.env.*
# 値の入っていないテンプレートだけはコミットする
!.env.example
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# データフォルダ（フォルダ構成だけ残し、中身はコミットしない）
Input/*
!Input/.gitkeep
Work/*
!Work/.gitkeep
tmp/
Output/*
!Output/.gitkeep
Reference/*
!Reference/.gitkeep
Sample/*
